{
  "name": "dhs-enterprise-coding-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "test": "pnpm build && pnpm -r test && node --test distribution/packaging.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "company-agent": "node scripts/company-agent.mjs",
    "package:runtime": "pnpm build && node distribution/build.mjs",
    "qualify:runtime": "pnpm build && node distribution/qualify.mjs",
    "demo:reset": "node scripts/demo.mjs reset",
    "demo:start": "node scripts/demo.mjs start"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "js-yaml": "4.2.0"
  }
}
